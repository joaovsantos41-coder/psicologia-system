generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  role      String
  createdAt DateTime @default(now())

  patients      Patient[]
  consultations Consultation[]
}

model Patient {
  id        Int      @id @default(autoincrement())
  name      String
  email     String?  @unique
  phone     String?
  birthDate DateTime?
  notes     String?

  psychologistId Int
  psychologist   User @relation(fields: [psychologistId], references: [id])

  createdAt DateTime @default(now())

  consultations Consultation[]
}

model Consultation {
  id             Int      @id @default(autoincrement())
  date           DateTime
  notes          String?
  status         String   @default("Agendada")
  value Float?

  patientId      Int
  patient        Patient  @relation(fields: [patientId], references: [id])

  psychologistId Int
  psychologist   User     @relation(fields: [psychologistId], references: [id])

  createdAt      DateTime @default(now())
}